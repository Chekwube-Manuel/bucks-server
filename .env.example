# === Required ===
# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/church_streaming?sslmode=disable

# Secret key used to sign JWT tokens (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret

# === Optional ===
# TCP port the server listens on (default: 8443)
PORT=8443

# TLS certificate and private key (PEM). Required in production.
# When omitted the server falls back to plain HTTP (development only).
TLS_CERT_FILE=/path/to/cert.pem
TLS_KEY_FILE=/path/to/key.pem

# STUN/TURN server for WebRTC ICE negotiation
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Prometheus metrics scrape port (default: 9090)
METRICS_PORT=9090